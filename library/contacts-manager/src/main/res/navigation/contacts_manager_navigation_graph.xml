<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contacts_manager_navigation_graph"
    app:startDestination="@id/contactsPickerFragment">

    <fragment
        android:id="@+id/contactsPickerFragment"
        android:name="com.planner.library.contacts_manager.ui.ContactsPickerFragment"
        android:label="fragment_choose_contacts"
        tools:layout="@layout/fragment_contacts_picker">
        <argument
            android:name="preselectedContactIds"
            app:argType="long[]"
            app:nullable="true" />
        <argument
            android:name="resultKey"
            app:argType="string" />
    </fragment>
</navigation>
